{
  "name": "comfyui-controlpanel",
  "private": true,
  "description": "A lightweight ComfyUI control panel for local administration and workflow metadata repair",
  "keywords": [
    "comfyui",
    "custom node",
    "extension"
  ],
  "files": [
    "frontend/",
    "./*.config.ts",
    "scripts/"
  ],
  "type": "module",
  "scripts": {
    "build": "bun typecheck && bun frontend/build.ts",
    "build:custom-node": "bun scripts/build-custom-nodes.ts",
    "build:css-type": "bun scripts/create-modulecss-types.ts",
    "deploy:dev": "bun run build && bun scripts/deploy-dev.ts",
    "deploy:local": "bun scripts/deploy-local.ts",
    "dev": "bun typecheck && bun frontend/dev.ts",
    "fix": "bun lint:fix && bun fmt",
    "fmt": "oxfmt && bun fmt:backend",
    "fmt:check": "oxfmt --check && bun fmt:backend --check",
    "fmt:backend": "bun uv:local run ruff format --no-cache .",
    "lint": "oxlint && bun lint:css && bun lint:backend",
    "lint:agent": "oxlint --format=agent && bun lint:css --no-color && bun lint:backend --output-format json",
    "lint:fix": "oxlint --fix && bun lint:css --fix && bun lint:backend --fix",
    "lint:css": "bun stylelint --no-cache 'frontend/**/*.css'",
    "lint:backend": "bun uv:local run ruff check --no-cache .",
    "init:template": "bun scripts/init-template.ts",
    "release:check": "bun scripts/validate-release.ts",
    "release:github": "bun scripts/prepare-github-release.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "skills:check": "bun scripts/sync-comfyui-skills.ts --check",
    "skills:sync": "bun scripts/sync-comfyui-skills.ts",
    "test": "bun test:frontend && bun test:backend -v",
    "test:agent": "AGENT=1 bun test:frontend --only-failures && bun test:backend -q",
    "test:backend": "bun uv:local run pytest -p no:cacheprovider -n auto tests/python tests/backend",
    "test:frontend": "bun test --preload ./frontend/test/setup.ts --parallel ./frontend/test",
    "test:unit": "bun scripts/ci-test.ts -- --no-dots",
    "test:watch": "bun test --preload ./frontend/test/setup.ts --watch ./frontend/test",
    "test:coverage": "bun test --preload ./frontend/test/setup.ts --coverage ./frontend/test",
    "typecheck": "bun build:css-type && bun typecheck:frontend && bun typecheck:test",
    "typecheck:frontend": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./frontend/src/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p ./frontend/test/tsconfig.json",
    "uv:local": "mkdir -p .ci-test-tmp && UV_CACHE_DIR=\"$(pwd)/.ci-cache/uv\" UV_TOOL_DIR=\"$(pwd)/.ci-cache/uv-tools\" TEMP=\"$(pwd)/.ci-cache/tmp\" TMP=\"$(pwd)/.ci-cache/tmp\" TMPDIR=\"$(pwd)/.ci-cache/tmp\" uv --cache-dir \"$(pwd)/.ci-cache/uv\"",
    "validate": "bun typecheck && bun lint && bun fmt:check && bun run test",
    "validate:agent": "bun typecheck && bun lint:agent && bun fmt:check && bun test:agent",
    "validate:ci": "bun validate",
    "version:bump": "bun scripts/bump-version.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.16"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "1.47.12",
    "@happy-dom/global-registrator": "^20.14.5",
    "@tbela99/css-parser": "^1.6.5",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@comfyorg/comfyui-desktop-bridge-types": "0.1.2"
  },
  "packageManager": "bun@1.4.2"
}
