{
  "name": "comfyui-controlpanel",
  "private": true,
  "description": "A lightweight ComfyUI control panel that restores legacy local administration features no longer available in ComfyUI Manager.",
  "type": "module",
  "scripts": {
    "dev": "tsc --noEmit -p frontend/tsconfig.json && vite build --watch --config frontend/vite.config.ts",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "bump:version": "uv version --bump patch",
    "eslint": "eslint ./frontend",
    "eslint:fix": "eslint ./frontend --fix",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "pnpm test:unit",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:backend": "uv run pytest tests/python tests/backend -q",
    "test:unit": "pnpm test:frontend && pnpm test:backend",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config frontend/vitest.config.ts"
  },
  "keywords": [
    "comfyui",
    "custom node",
    "extension"
  ],
  "author": "craftingmod",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "vite": "^8.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.1"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "^1.45.20",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "typescript-7": "npm:typescript@7.0.1-rc",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
