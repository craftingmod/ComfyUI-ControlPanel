{
  "name": "comfyui-controlpanel",
  "private": true,
  "description": "A lightweight ComfyUI control panel that restores legacy local administration features no longer available in ComfyUI Manager.",
  "keywords": [
    "comfyui",
    "custom node",
    "extension"
  ],
  "license": "MIT",
  "author": "craftingmod",
  "type": "module",
  "scripts": {
    "deploy:dev": "pnpm build && bun scripts/deploy-dev.ts",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "fmt": "oxfmt && pnpm fmt:backend",
    "deploy:local": "bun scripts/deploy-local.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "fmt:backend": "uv run ruff format --no-cache .",
    "test:watch": "vitest --config frontend/vitest.config.ts --configLoader runner",
    "fmt:check": "oxfmt --check && pnpm fmt:backend --check",
    "dev": "pnpm typecheck && bun frontend/dev.ts",
    "test:backend": "uv run pytest -p no:cacheprovider tests/python tests/backend -q",
    "test:frontend": "vitest run --config frontend/vitest.config.ts --configLoader runner",
    "bump:version": "bun scripts/bump-version.ts",
    "test:coverage": "vitest run --coverage --config frontend/vitest.config.ts --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/src/tsconfig.json && tsc --noEmit -p frontend/test/tsconfig.json",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "release:github": "bun scripts/prepare-github-release.ts",
    "build:custom-node": "bun scripts/build-custom-nodes.ts",
    "test:unit": "bun scripts/ci-test.ts",
    "eslint:fix": "pnpm lint:frontend --fix",
    "validate:ci": "pnpm validate",
    "lint:backend": "uv run ruff check --no-cache .",
    "lint:frontend": "oxlint",
    "release:check": "bun scripts/validate-release.ts",
    "build": "pnpm typecheck && bun frontend/build.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "test": "pnpm test:unit",
    "eslint": "pnpm lint:frontend",
    "test:tooling": "bun test tests/tooling"
  },
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "^1.45.20",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "fflate": "^0.8.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.10.0"
}
