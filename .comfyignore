# Ignore every root entry by default
/*

# Required ComfyUI entry point
!/__init__.py

# Runtime directories
!/assets/icon.svg
!/backend/
!/backend/**
!/locales/
!/locales/**
!/web/
!/web/**

# Distribution metadata
!/LICENSE
!/pyproject.toml
!/README.md
!/THIRD_PARTY_NOTICES.md

# Ignore assets except one
!/assets/
/assets/**
!/assets/icon.svg
